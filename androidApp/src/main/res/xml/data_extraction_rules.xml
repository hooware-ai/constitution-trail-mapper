<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup rules. Recent routes and unfinished planner forms stay on this device: they are
    left out of cloud backup and device transfer. Only exclusions are listed, so every other file keeps the default behavior while
    #20 decides the policy for the rest.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="trail_mapper_recent_routes.xml" />
        <exclude domain="sharedpref" path="trail_mapper_planner_drafts.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="trail_mapper_recent_routes.xml" />
        <exclude domain="sharedpref" path="trail_mapper_planner_drafts.xml" />
    </device-transfer>
</data-extraction-rules>
